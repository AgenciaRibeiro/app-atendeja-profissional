    {
      "parameters": {
        "jsCode": "const PRECOS_OFICIAIS = {\n  essencial: 1,\n  pro: 1,\n  empresa: 1\n};\nconst items = $input.all();\nconst results = [];\nfor (const item of items) {\n  const raw = item.json || {};\n  const body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\n  const planoKey = String(body.plano || 'pro').trim().toLowerCase();\n  const valorMensal = PRECOS_OFICIAIS[planoKey] || PRECOS_OFICIAIS.pro;\n  const empresa = String(body.empresa || 'Cliente AtendeJa').trim();\n  const atendente = String(body.atendente || 'Atendente').trim();\n  const nicho = String(body.nicho || 'geral').trim();\n  const whatsapp = String(body.whatsapp || '').replace(/\\D/g, '');\n  const cidade = String(body.cidade || '').trim();\n  const metodo = 'pix';\n  const ts = Date.now();\n  const external_reference = 'ATJ-' + ts + '-' + Math.random().toString(36).slice(2, 7).toUpperCase();\n  const email = String(body.email || '').trim() || ('cliente+' + ts + '@atendeja.com.br');\n  const description = 'AtendeJa Plano ' + planoKey.toUpperCase() + ' - ' + empresa;\n  results.push({\n    json: {\n      external_reference,\n      pedidoId: external_reference,\n      plano: planoKey,\n      valorMensal,\n      metodo,\n      description,\n      email,\n      empresa,\n      atendente,\n      nicho,\n      whatsapp,\n      cidade,\n      metadata: {\n        pedidoId: external_reference,\n        plano: planoKey,\n        empresa,\n        atendente,\n        nicho,\n        whatsapp,\n        cidade\n      }\n    }\n  });\n}\nreturn results;"
      },
