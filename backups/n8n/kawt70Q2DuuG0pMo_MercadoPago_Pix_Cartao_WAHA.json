        "jsonBody": "={{ (() => { const m = $json.metadata || {}; const rawTel = String(m.whatsapp || '').replace(/\\\\D/g, ''); const tel = rawTel && !rawTel.startsWith('55') && (rawTel.length === 10 || rawTel.length === 11) ? '55' + rawTel : rawTel; const link = `https://atendeja.3jr.com.br/?atendente=${encodeURIComponent(m.atendente || 'Equipe')}&empresa=${encodeURIComponent(m.empresa || 'Sua Empresa')}&nicho=${encodeURIComponent(m.nicho || 'geral')}`; return JSON.stringify({ session: 'default', chatId: tel ? `${tel}@c.us` : '5569993768304@c.us', text: `Olá, ${m.atendente || 'cliente'}! 🎉 Seu pagamento no Mercado Pago (${$json.external_reference || $json.id}) para o *AtendeJá* (${m.empresa || 'Sua Empresa'}) foi aprovado!\\\\n\\\\nSeu acesso já está ativo:\\\\n${link}\\\\n\\\\nConte com a 3 J R Agência Digital!` }); })() }}",
